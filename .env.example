DEBUG=True
SECRET_KEY=change-me-in-production
DATABASE_URL=postgres://user:pass@localhost:5432/aptirecall
DATABASE_NAME=aptirecall
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OPENAI_API_KEY=
AI_REQUEST_TIMEOUT=120
TESSERACT_CMD=
TTS_PROVIDER=edge-tts
TTS_VOICE=en-US-JennyNeural
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_LIFETIME=3600
JWT_REFRESH_TOKEN_LIFETIME=604800
# Frontend API base URL
# Development default: Vite proxies /api to Django backend
VITE_API_URL=/api
# Production: VITE_API_URL=https://your-backend-domain/api

# Mobile API base URL
EXPO_PUBLIC_API_URL=http://localhost:8000/api

DJANGO_SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006
CORS_ALLOW_CREDENTIALS=True
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006
SECURE_SSL_REDIRECT=False
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
DATABASE_SSL_REQUIRED=False
DJANGO_LOG_LEVEL=WARNING
HEALTH_CHECK_ENABLED=True
